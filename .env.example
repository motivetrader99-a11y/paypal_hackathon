# Leave these empty to run the whole demo offline with simulated payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Free key from https://aistudio.google.com/apikey. Leave empty for the scripted agent and built-in rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional alternative, used only if GEMINI_API_KEY is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
PUBLIC_URL=http://localhost:3000
